###############################################
# STEP-UI BACKEND CONFIGURATION
###############################################

# URL step-ca serveru (např. https://ca.example.com)
STEP_CA_URL=https://your-step-ca-url

# Root fingerprint z `step ca root` nebo z konfigurace step-ca
STEP_CA_FINGERPRINT=YOUR_FINGERPRINT_HERE

# Název provisioneru, který se má použít jako výchozí
STEP_CA_PROVISIONER=bootstrap


###############################################
# FRONTEND CONFIGURATION
###############################################

# URL backendu uvnitř docker-compose
# (frontend komunikuje s backendem přes service name)
BACKEND_URL=http://backend:8080


###############################################
# DOCKER IMAGE TAGS (volitelné)
###############################################

# Pokud chceš používat vlastní tagy
IMAGE_TAG=latest
